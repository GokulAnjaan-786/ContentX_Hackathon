# CONTENTX ENVIRONMENT CONFIGURATION TEMPLATE

# ENVIRONMENT MODE (development | test | production)
NODE_ENV="development"
PORT="3000"

# DEMO MODE (set to false in production)
CONTENTX_DEMO_MODE="true"

# SECURITY & AUTHENTICATION
# Production MUST provide a strong, random JWT secret (at least 32 characters).
# Example to generate: openssl rand -base64 48
JWT_SECRET="<generate-a-secure-random-secret-at-least-32-chars>"
MAX_FILE_SIZE_MB="25"
CORS_ORIGIN="http://localhost:3000"

# PRODUCTION ADMIN BOOTSTRAP (Optional)
# If provided, creates the initial production administrator account securely on boot if no Admin exists.
CONTENTX_ADMIN_EMAIL="admin@yourdomain.com"
CONTENTX_ADMIN_PASSWORD="<configure-strong-production-admin-password>"

# CONTENTX AI PROVIDER & OLLAMA CONFIGURATION (NO OPENROUTER)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_GENERATION_MODEL="qwen2.5:7b"
OLLAMA_EMBEDDING_MODEL="bge-m3:latest"
OLLAMA_EMBEDDING_DIM="1024"
OLLAMA_NUM_CTX="16384"
OLLAMA_TEMPERATURE="0.1"
OLLAMA_GENERATION_EXECUTION_MODE="sequential"

# CHUNKING & SELECTIVE RAG CONFIGURATION
CHUNK_TARGET_WORDS="600"
CHUNK_OVERLAP_WORDS="50"
RAG_MIN_WORDS_THRESHOLD="800"

# OPTIONAL GROUNDED SERVERS
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
